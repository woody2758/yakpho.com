# ============================================================
# YakPho - Retire Old Catalog: Redirect pages to /th/products
# Keep assets/ accessible for existing image references
# ============================================================
RewriteEngine On

# 1. Allow static assets (images, fonts, css, js) to be served normally
RewriteCond %{REQUEST_URI} /catalog/assets/ [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} \.(webp|jpg|jpeg|png|svg|ico|gif|woff2?|css|js)$ [NC]
RewriteRule ^ - [L]

# 2. 301 Permanent Redirect any web page in /catalog/ to the modern catalog
RewriteRule ^.*$ /th/products [R=301,L]
