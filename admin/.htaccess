RewriteEngine On
RewriteBase /admin/

# ให้ใช้ไฟล์จริงก่อน
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routing สำหรับ Scanner PWA
RewriteRule ^scanner/login/?$ pack_scanner_login.php [L,QSA]
RewriteRule ^scanner/?$ pack_scanner.php [L,QSA]

# ถ้าเป็น .html -> .php
RewriteRule ^(.+)\.html$ $1.php [L]

# รองรับ dashboard/ หรือ orders/
RewriteRule ^dashboard/?$ dashboard.php [L]

# ไฟล์หลักของ Admin
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]
