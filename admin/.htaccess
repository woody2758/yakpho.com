RewriteEngine On

# ให้ใช้ไฟล์จริงก่อน
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routing สำหรับ Scanner PWA
RewriteRule ^scanner/login/?$ pack_scanner_login.php [L,QSA]
RewriteRule ^scanner/?$ pack_scanner.php [L,QSA]

# ถ้าเป็น .html → .php
RewriteRule ^(.+)\.html$ $1.php [L]

# ไฟล์หลักของ Admin (ป้องกัน Infinite Loop ถ้าไฟล์ไม่มีอยู่จริง)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# ============================================================
# Session Timeout (1 Year) (Moved to config.php via ini_set)
# ============================================================
